{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "enum": ["course", "lecture_notes", "tool", "article", "book", "video", "dataset", "document"] },
    "title": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "provider_domain": { "type": "string", "minLength": 1 },
    "domain_type": { "type": "string" },
    "subject": { "type": "string", "minLength": 1 },
    "sub_topics": { "type": "array", "items": { "type": "string" } },
    "level": { "type": ["string", "null"] },
    "language": { "type": "array", "items": { "type": "string" } },
    "duration": { "type": ["string", "null"] },
    "format": { "type": "string" },
    "cost": { "type": "string" },
    "access": { "type": "string" },
    "url": { "type": "string", "format": "uri" },
    "direct_file_url": { "type": ["string", "null"], "format": "uri" },
    "file_type": { "type": ["string", "null"] },
    "file_size": { "type": ["string", "null"] },
    "summary": { "type": "string" },
    "modules": { "type": "array", "items": { "type": "string" } },
    "prerequisites": { "type": ["string", "null"] },
    "certificate_offered": { "type": "string", "enum": ["yes", "no", "unknown"] },
    "license_name": { "type": ["string", "null"] },
    "license_url": { "type": ["string", "null"] },
    "license_evidence": { "type": ["string", "null"] },
    "redistribution_allowed": { "type": "string", "enum": ["yes", "no", "unknown"] },
    "attribution_text": { "type": ["string", "null"] },
    "embeddable": { "type": "string", "enum": ["yes", "no", "unknown"] },
    "date_published_or_updated": { "type": ["string", "null"] },
    "verified_date": { "type": "string" },
    "verified_by_opening_page": { "type": "boolean" },
    "confidence": { "type": "string", "enum": ["high", "medium", "low", "unknown"] },
    "notes": { "type": ["string", "null"] }
  },
  "required": [
    "id", "type", "title", "provider", "provider_domain", "domain_type", "subject",
    "sub_topics", "language", "format", "cost", "access", "url", "summary", "modules",
    "certificate_offered", "redistribution_allowed", "embeddable", "verified_date", "verified_by_opening_page"
  ]
}
